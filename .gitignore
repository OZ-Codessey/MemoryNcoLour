
# Vercel 로컬 설정 및 빌드 캐시
.vercel

# 파이썬 가상환경 (용량 초과 주원인 방지)
.venv/
venv/
env/
ENV/
temp_env/

# 파이썬 바이트코드 및 캐시
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# 환경 변수 및 보안 키 (GitHub 유출 방지)
.env
.env.local
.env.*.local
*.env

# 운영체제 및 에디터 임시 파일
.DS_Store
Thumbs.db
.vscode/
.idea/

# 데이터베이스 및 대용량 압축/임시 파일
*.sqlite3
*.db
*.log
*.zip
*.tar.gz

# Node / 프론트엔드 종속성 (해당되는 경우)
node_modules/
dist/
build/

# 로컬 시험 결과 (scripts/try_paint.py 등)
out/
