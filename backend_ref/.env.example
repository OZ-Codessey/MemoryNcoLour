# 문장 나누기·후보 고르기 — Codyssey 공개 API 키 (sk-cody-…). 주소는 /public-api-console 문서 탭의 'Public API Base URL'
ANTHROPIC_BASE_URL=https://copa.codyssey.kr
ANTHROPIC_API_KEY=여기에_발급받은_키
# MAC_CLAUDE_MODEL=claude-sonnet-4      (Codyssey 주소면 기본값이 이것. 다른 모델을 쓰려면 주석을 풀고 바꿈)
# 임베딩
VOYAGE_API_KEY=여기에_발급받은_키
# 선택: 예전 방식(MAC_ENGINE=legacy) 이나 MAC_SPLIT_LLM/MAC_PICK_LLM=gemini 를 쓸 때만
# GEMINI_API_KEY=여기에_발급받은_키
